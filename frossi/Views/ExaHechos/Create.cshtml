@model frossi.Models.ExaHechos

@{
    ViewData["Title"] = "Create";
    //Layout = "~/Views/Shared/_Layout.cshtml";
    Layout = null;
}


<!DOCTYPE html>

<html>

<head>
    <meta name="viewport" content="width=device-width" />
    <title>Nuevo Exámen Teórico</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body>

    <div class="container mt-5 pt-5">
        <div class="text-center mb-4">
            <h2>Nuevo Examen Teórico</h2>
        </div>


        <div class="row justify-content-center">

            <div class="col-12 col-xl-4 col-md-6">

        @* 
<div class="row">
    <div class="col-md-4"> *@
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="IdTipoExamen" class="control-label">Seleccione el tipo de exámen</label>
                <select asp-for="IdTipoExamen" class ="form-control" asp-items="ViewBag.IdTipoExamen"></select>
            </div>
            <div class="form-group">
                <label asp-for="IdSolicitante" class="control-label">Tipo de Documento</label>
                <select asp-for="IdSolicitante" class ="form-control" asp-items="ViewBag.IdTipodoc"></select>
            </div>
            <div class="form-group">
                        <label asp-for="NroDoc" class="control-label"></label>
                        <input asp-for="NroDoc" class="form-control" />
                <span asp-validation-for="Correctas" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Incorrectas" class="control-label"></label>
                <input asp-for="Incorrectas" class="form-control" />
                <span asp-validation-for="Incorrectas" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FechaInicio" class="control-label"></label>
                <input asp-for="FechaInicio" class="form-control" />
                <span asp-validation-for="FechaInicio" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FechaFin" class="control-label"></label>
                <input asp-for="FechaFin" class="form-control" />
                <span asp-validation-for="FechaFin" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>

</div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>